{
  "opencollection": "1.0.0",
  "info": {
    "name": "create meters Meter Details API",
    "version": "1.1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Meter Details",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get meter details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.staging.leap.energy/v2/meters/:meter_id",
            "params": [
              {
                "name": "meter_id",
                "value": "",
                "type": "path",
                "description": "Meter ID"
              }
            ]
          },
          "docs": "Get details about a meter such as customer, utility, site, and device information."
        },
        {
          "info": {
            "name": "Search meter details",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.staging.leap.energy/v2/meters/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve meter details, such as customer, utility, site, and device information for all meters. Optionally filter by one or more request parameters."
        }
      ]
    }
  ],
  "bundled": true
}